{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build C++ Program",
      "type": "shell",
      "command": "g++",
      "args": [
        "-std=c++17",
        "-I",
        "${workspaceFolder}/include",
        "${workspaceFolder}/src/main.cpp",
        "${workspaceFolder}/src/ParkingLot.cpp",
        "${workspaceFolder}/src/Vehicle.cpp",
        "-o",
        "${workspaceFolder}/parking_management_system.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile"
    }
  ]
}
