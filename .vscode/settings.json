{
  "files.associations": {
    "*.h": "cpp",
    "*.hpp": "cpp"
  },
  "C_Cpp.default.includePath": [
    "${workspaceFolder}/include",
    "${workspaceFolder}/src"
  ],
  "C_Cpp.default.compilerPath": "g++",
  "C_Cpp.default.cppStandard": "c++17",
  "C_Cpp.default.configurationProvider": "ms-vscode.cpptools"
}
